#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/kscan_mock.h>

/ {
    keymap {
        compatible = "zmk,keymap";
        default_layer {
            bindings = <&kp A &kp B &kp C &kp D>;
        };
    };
};


&kscan {
    events = <
        ZMK_MOCK_RELEASE(0,0,40*500)
        // no meaningful events, we'll have a demo mode cycling through synthetic states
    >;
};

&sdl_dc {
    width = <160>;
    height = <68>;
};
